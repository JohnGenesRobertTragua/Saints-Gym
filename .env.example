# Saints Gym deployment configuration
# Copy this file to .env only if your deployment setup loads .env files.
# Never commit the real .env file.

FLASK_SECRET_KEY=replace-with-a-long-random-secret
SAINTS_MASTER_USERNAME=replace-with-your-master-username
SAINTS_MASTER_PASSWORD=replace-with-your-master-password

# Optional Waitress settings
SAINTS_HOST=127.0.0.1
SAINTS_PORT=5000
SAINTS_THREADS=16

# Database path: keep this as ./gym.db for local installation.
# The launcher changes to this project folder before starting the server.
SAINTS_DATABASE_PATH=./gym.db
